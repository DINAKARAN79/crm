# Database
DATABASE_URL="postgresql://postgres:1234@localhost:5432/dct_crm?schema=public"

# Authentication
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="24h"
APPLICANT_ID_ENCRYPTION_KEY="generate-a-32-byte-base64-key"

# CORS
CORS_ORIGIN="http://localhost:3000"

# API
PORT=3001
NODE_ENV=development
# Optional public origin for company API links. Leave unset to detect it from the request.
# PUBLIC_API_BASE_URL="https://api.yourdomain.com"
# Comma-separated hosts allowed in production when PUBLIC_API_BASE_URL is unset.
# ALLOWED_API_HOSTS="api.yourdomain.com"
# Set to 1, or to the proxy address, only when a known proxy sets X-Forwarded-* headers.
# TRUST_PROXY="1"
GOOGLE_MAPS_API_KEY="your-google-maps-geocoding-api-key"

# AI Service
OPENAI_API_KEY="your-openai-api-key"
NODE_API_URL="http://localhost:3001"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"